{
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev",
    "beforeBuildCommand": "npm --prefix frontend run build",
    "devPath": "http://localhost:3001",
    "distDir": "../frontend/out"
  },
  "package": {
    "productName": "LocalMind OS",
    "version": "1.1.13"
  },
  "tauri": {
    "allowlist": {
      "all": true,
      "shell": {
        "all": false,
        "open": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.localmind.os",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "externalBin": [
        "bin/localmind-backend",
        "bin/ollama"
      ]
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "LocalMind OS",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "fullscreen": false,
        "url": "index.html"
      }
    ]
  }
}
